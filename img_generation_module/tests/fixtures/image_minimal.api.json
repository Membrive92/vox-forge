{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "fp8_e4m3fn" },
    "_meta": { "title": "Load Diffusion Model" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "qwen_image" },
    "_meta": { "title": "Load CLIP" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "placeholder positive", "clip": ["2", 0] },
    "_meta": { "title": "PROMPT_POSITIVE" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "placeholder negative", "clip": ["2", 0] },
    "_meta": { "title": "PROMPT_NEGATIVE" }
  },
  "6": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "_meta": { "title": "SIZE" }
